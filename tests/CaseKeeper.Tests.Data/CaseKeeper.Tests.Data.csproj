<!-- Checks the data layer: upgrading a v0.2 library, the category catalogue, records, the hash-chained
     audit trail (including tamper detection), Deleted items, encryption and snapshots, and backup merging.
     How to run: see tests/README.md. Exit code 0 means everything passed. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
    <Src>$(MSBuildThisFileDirectory)..\..\CaseKeeper\</Src>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <Compile Include="$(Src)Data\Database.cs" />
    <Compile Include="$(Src)Data\Database.Records.cs" />
    <Compile Include="$(Src)Data\Database.BulkImport.cs" />
    <Compile Include="$(Src)Models\BulkImport.cs" />
    <Compile Include="$(Src)Data\DefaultCategories.cs" />
    <Compile Include="$(Src)Models\Models.cs" />
    <Compile Include="$(Src)Models\CaseRecords.cs" />
    <Compile Include="$(Src)UI\NaturalComparer.cs" />
    <Compile Include="$(Src)Services\AppLog.cs" />
    <Compile Include="$(Src)Services\AppPaths.cs" />
    <Compile Include="$(Src)Services\AppPackage.cs" />
    <Compile Include="$(Src)Services\Vault.cs" />
  </ItemGroup>
</Project>
