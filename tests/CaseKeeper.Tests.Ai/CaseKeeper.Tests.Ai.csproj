<!-- Checks the cloud AI support with a scripted stand-in for the network (no internet, no real keys): Anthropic, OpenAI,
     Claude on Microsoft Foundry and OpenAI on Foundry (addresses, keys in the right header only, the JSON schema and
     reasoning effort sent, structured answers, refusals, cut-off answers, rate limits, rejected keys, missing models or
     deployments, outages, no redirects followed), the allowed hosts (HTTPS only, Foundry resource names), the schema
     adaptations for each service, and masking (names, contact details, numbers and addresses replaced, put back exactly,
     in JSON and while streaming, and nothing personal in what is sent).
     How to run: see tests/README.md. Exit code 0 means everything passed. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
    <Src>$(MSBuildThisFileDirectory)..\..\CaseKeeper\</Src>
  </PropertyGroup>
  <ItemGroup>
    <!-- The same versions as the app (see CaseKeeper.csproj and its packages.lock.json) -->
    <PackageReference Include="Anthropic" Version="13.6.0" />
    <PackageReference Include="Anthropic.Foundry" Version="1.0.0" />
    <PackageReference Include="OpenAI" Version="2.15.0" />
    <!-- Security pins: the AI libraries above were built against older versions of these. Pinning the newest
         stable releases keeps the sign-in and HTTP code they share patched (CaseKeeper only ever uses key sign-in). -->
    <PackageReference Include="Azure.Core" Version="1.64.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.92.0" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.92.0" />
    <PackageReference Include="Microsoft.IdentityModel.Abstractions" Version="8.23.0" />
    <PackageReference Include="System.ClientModel" Version="1.17.0" />
    <PackageReference Include="System.Memory.Data" Version="10.0.14" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
    <Compile Include="$(Src)Data\Database.cs" />
    <Compile Include="$(Src)Data\Database.Records.cs" />
    <Compile Include="$(Src)Data\Database.BulkImport.cs" />
    <Compile Include="$(Src)Data\DefaultCategories.cs" />
    <Compile Include="$(Src)Models\Models.cs" />
    <Compile Include="$(Src)Models\CaseRecords.cs" />
    <Compile Include="$(Src)Models\BulkImport.cs" />
    <Compile Include="$(Src)UI\NaturalComparer.cs" />
    <Compile Include="$(Src)Services\AppLog.cs" />
    <Compile Include="$(Src)Services\AppPaths.cs" />
    <Compile Include="$(Src)Services\AppPackage.cs" />
    <Compile Include="$(Src)Services\Vault.cs" />
    <Compile Include="$(Src)Services\LibraryService.cs" />
    <Compile Include="$(Src)Services\LibraryLock.cs" />
    <Compile Include="$(Src)Services\OcrService.cs" />
    <Compile Include="$(Src)Services\PdfRenderService.cs" />
    <Compile Include="$(Src)Services\Performance.cs" />
    <Compile Include="$(Src)Services\Ai\AiHardware.cs" />
    <Compile Include="$(Src)Services\Ai\Masker.cs" />
    <Compile Include="$(Src)Services\Ai\CloudAi.cs" />
    <Compile Include="$(Src)Services\Ai\CloudJsonClient.cs" />
    <Compile Include="$(Src)Services\Deadlines.cs" />
    <Compile Include="$(Src)Services\HearingSync.cs" />
    <Compile Include="$(Src)Services\BackupService.cs" />
    <Compile Include="$(Src)Services\DataRemoval.cs" />
    <Compile Include="$(Src)Services\BulkImport\*.cs" />
  </ItemGroup>
</Project>
