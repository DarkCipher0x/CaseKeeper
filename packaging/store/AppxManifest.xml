<?xml version="1.0" encoding="utf-8"?>
<!--
  CaseKeeper's Microsoft Store (MSIX) package manifest.

  This is a template: build-store.ps1 fills in the dollar-sign placeholders below and writes the
  finished copy into the package. Don't edit the placeholders by hand. The identity values come from
  packaging\store\store-identity.json, which you copy from Partner Center (see docs\STORE.md).

  Privacy: nothing here names a person or a machine. The publisher is the "CN=..." value Partner
  Center assigns to the developer account, and the display name is the brand.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="$IDENTITY_NAME$"
    Publisher="$PUBLISHER$"
    Version="$VERSION$"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>$DISPLAY_NAME$</DisplayName>
    <PublisherDisplayName>$PUBLISHER_DISPLAY_NAME$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Keeps family court documents, notes, a timeline and complaints together, encrypted on your own PC.</Description>

    <!-- No file-system settings here, and no restricted capability beyond runFullTrust: Windows'
         normal per-app handling of AppData applies. The Store copy keeps its settings and logs in its
         own package folder (removed by Windows on uninstall) and the library in %USERPROFILE%\CaseKeeper,
         outside AppData, so uninstalling never deletes anyone's case. See CaseKeeper\Services\AppPaths.cs. -->
  </Properties>

  <Dependencies>
    <!-- Windows 10 2004 or newer: the oldest Windows 10 line that still gets updates is 22H2 (19045) -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-GB" />
  </Resources>

  <Applications>
    <!-- The Id must match ApplicationId in CaseKeeper\Services\AppPackage.cs -->
    <Application Id="CaseKeeper" Executable="CaseKeeper.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="$DISPLAY_NAME$"
        Description="Family court document manager"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="CaseKeeper" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A normal desktop (WPF) program, not a sandboxed UWP app -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
