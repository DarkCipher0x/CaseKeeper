# Normalise line endings in the repository; Windows tools get CRLF on checkout
* text=auto

*.cs      text eol=crlf
*.xaml    text eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.ps1     text eol=crlf
*.iss     text eol=crlf
*.md      text eol=lf
*.yml     text eol=lf
*.json    text eol=lf

*.png     binary
*.ico     binary
*.pdf     binary
*.docx    binary
*.zip     binary
