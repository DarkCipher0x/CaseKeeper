<!-- Dark palette, the DarkCipher Systems brand: deep teal-black, teal accent, warm amber highlights.
     Same keys as Light.xaml, so the app can swap between them at any time. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="ThemeName">Dark</sys:String>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppBackground" Color="#0B1517"/>
    <SolidColorBrush x:Key="Surface" Color="#112326"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#0F1D20"/>
    <SolidColorBrush x:Key="InputBackground" Color="#0D1A1C"/>
    <SolidColorBrush x:Key="PopupBackground" Color="#152A2D"/>
    <SolidColorBrush x:Key="ViewerBackground" Color="#071012"/>
    <SolidColorBrush x:Key="ControlHover" Color="#18302F"/>

    <!-- Lines and text -->
    <SolidColorBrush x:Key="BorderBrush" Color="#22393D"/>
    <SolidColorBrush x:Key="GridLine" Color="#1A2E31"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E8F3F2"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A8C1BF"/>
    <SolidColorBrush x:Key="FaintIcon" Color="#2E4B50"/>

    <!-- Accent: Primary fills (OnPrimary text sits on it), AccentText is for coloured words -->
    <SolidColorBrush x:Key="Primary" Color="#3DD6D0"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#66ECE6"/>
    <SolidColorBrush x:Key="PrimarySoft" Color="#123331"/>
    <SolidColorBrush x:Key="AccentText" Color="#3DD6D0"/>
    <SolidColorBrush x:Key="OnPrimary" Color="#052826"/>
    <SolidColorBrush x:Key="Warm" Color="#F2A65A"/>
    <SolidColorBrush x:Key="WarmSoft" Color="#2E2214"/>
    <SolidColorBrush x:Key="Violet" Color="#A970FF"/>

    <!-- Sidebar -->
    <SolidColorBrush x:Key="Sidebar" Color="#071012"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#112326"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#123331"/>
    <SolidColorBrush x:Key="SidebarAccent" Color="#3DD6D0"/>
    <SolidColorBrush x:Key="SidebarText" Color="#A8C1BF"/>
    <SolidColorBrush x:Key="SidebarTextActive" Color="#E8F3F2"/>
    <SolidColorBrush x:Key="SidebarHeader" Color="#5E7C79"/>
    <SolidColorBrush x:Key="SidebarFooter" Color="#6A8784"/>

    <!-- Status -->
    <SolidColorBrush x:Key="Star" Color="#F2C14E"/>
    <SolidColorBrush x:Key="Danger" Color="#FF7A7A"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#3A1F22"/>
    <SolidColorBrush x:Key="Success" Color="#5FD38D"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#12291C"/>
    <SolidColorBrush x:Key="Warning" Color="#F2C14E"/>
    <SolidColorBrush x:Key="WarningSoft" Color="#2B2512"/>
    <SolidColorBrush x:Key="CalloutBorder" Color="#4A3F1C"/>

    <!-- Odds and ends -->
    <SolidColorBrush x:Key="SearchHighlight" Color="#5A4A12"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#2E4B50"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#3D6066"/>
    <sys:Double x:Key="ShadowOpacity">0.55</sys:Double>
</ResourceDictionary>
