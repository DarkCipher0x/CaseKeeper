<!-- Light palette: the DarkCipher Systems / ParallelPath light theme, with the brand's dark sidebar
     kept as an anchor. Every colour the app uses lives here; Dark.xaml defines the same keys. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="ThemeName">Light</sys:String>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppBackground" Color="#F4F8F8"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F2F7F7"/>
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PopupBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ViewerBackground" Color="#E3ECEC"/>
    <SolidColorBrush x:Key="ControlHover" Color="#EAF3F2"/>

    <!-- Lines and text -->
    <SolidColorBrush x:Key="BorderBrush" Color="#D6E3E3"/>
    <SolidColorBrush x:Key="GridLine" Color="#E8EFEF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#11292B"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#3F5D5F"/>
    <SolidColorBrush x:Key="FaintIcon" Color="#B9CFCF"/>

    <!-- Accent: Primary fills (OnPrimary text sits on it), AccentText is for coloured words -->
    <SolidColorBrush x:Key="Primary" Color="#0B7A75"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#0C8782"/>
    <SolidColorBrush x:Key="PrimarySoft" Color="#E0F2F1"/>
    <SolidColorBrush x:Key="AccentText" Color="#0B7A75"/>
    <SolidColorBrush x:Key="OnPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Warm" Color="#B8681C"/>
    <SolidColorBrush x:Key="WarmSoft" Color="#FCEFE1"/>
    <SolidColorBrush x:Key="Violet" Color="#6D3FC0"/>

    <!-- Sidebar (stays brand-dark in both themes) -->
    <SolidColorBrush x:Key="Sidebar" Color="#0B1517"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#132427"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#143533"/>
    <SolidColorBrush x:Key="SidebarAccent" Color="#3DD6D0"/>
    <SolidColorBrush x:Key="SidebarText" Color="#A8C1BF"/>
    <SolidColorBrush x:Key="SidebarTextActive" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarHeader" Color="#5E7C79"/>
    <SolidColorBrush x:Key="SidebarFooter" Color="#6A8784"/>

    <!-- Status -->
    <SolidColorBrush x:Key="Star" Color="#C2700A"/>
    <SolidColorBrush x:Key="Danger" Color="#C62828"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#FDECEC"/>
    <SolidColorBrush x:Key="Success" Color="#126A33"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#E7F6EC"/>
    <SolidColorBrush x:Key="Warning" Color="#A15207"/>
    <SolidColorBrush x:Key="WarningSoft" Color="#FEF5E7"/>
    <SolidColorBrush x:Key="CalloutBorder" Color="#F0D3A2"/>

    <!-- Odds and ends -->
    <SolidColorBrush x:Key="SearchHighlight" Color="#FDE68A"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#BCCFCF"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#93ADAD"/>
    <sys:Double x:Key="ShadowOpacity">0.18</sys:Double>
</ResourceDictionary>
