<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 TFM gives access to Windows OCR, PDF rendering and the Share sheet -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>CaseKeeper</AssemblyTitle>
    <Product>CaseKeeper - Family Court Document Manager</Product>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Per-monitor DPI aware (v2), runs as the signed-in user: see app.manifest -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- The single place the version is set. The installer script reads it from the built exe,
         so bumping this number here is all that's needed for a new release. -->
    <Version>0.6.1</Version>
    <AssemblyVersion>0.6.1.0</AssemblyVersion>
    <FileVersion>0.6.1.0</FileVersion>
    <InformationalVersion>0.6.1</InformationalVersion>
    <!-- Publisher brand only. No personal names, e-mail addresses or machine details anywhere in the build. -->
    <Company>DarkCipher Systems</Company>
    <Authors>DarkCipher Systems</Authors>
    <Copyright>Copyright (c) 2026 DarkCipher Systems. Provided as-is, with no warranty. Not legal advice.</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Runtime tuning: profile-guided JIT for faster warm paths, background GC so the UI never stalls -->
    <TieredPGO>true</TieredPGO>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>

    <!-- Ships with its own .NET runtime, so people installing it need nothing else -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- WPF uses reflection heavily; trimming it breaks things in ways that only show at runtime -->
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Privacy: release builds carry no debug symbols (.pdb) and no local folder paths, so nothing
         about the build machine or its user ends up inside the installer. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>

    <!-- Supply chain: packages.lock.json pins every package, including indirect ones, to an exact
         version and content hash. A changed or substituted package fails the restore. CI restores in
         locked mode, so it can never quietly pick up something different from a local build. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Optional cloud AI: Claude (Anthropic API and Microsoft Foundry, Apache-2.0) and OpenAI (MIT). -->
    <PackageReference Include="Anthropic" Version="13.6.0" />
    <PackageReference Include="Anthropic.Foundry" Version="1.0.0" />
    <!-- ML-DSA-65 (post-quantum) verification of signed updates, the same as DarkCipher ServerManagement. MIT licence. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" />
    <PackageReference Include="OpenAI" Version="2.15.0" />
    <!-- Security pins: the AI libraries above were built against older versions of these. Pinning the newest
         stable releases keeps the sign-in and HTTP code they share patched (CaseKeeper only ever uses key sign-in). -->
    <PackageReference Include="Azure.Core" Version="1.64.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.92.0" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.92.0" />
    <PackageReference Include="Microsoft.IdentityModel.Abstractions" Version="8.23.0" />
    <PackageReference Include="System.ClientModel" Version="1.17.0" />
    <PackageReference Include="System.Memory.Data" Version="10.0.14" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <!-- 6.2.x is the last MIT release: PDFsharp 6.5 moved to AGPL-3.0 with a licence key, which CaseKeeper's
         MIT licence can't carry. Don't upgrade past 6.2 without checking the licence. -->
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <!-- Replaces the stock SQLite engine with SQLCipher, so the database file itself can be
         encrypted. Requires SQLitePCL.Batteries_V2.Init() at startup (see App.xaml.cs). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <!-- System.Security.Cryptography.ProtectedData and System.IO.Packaging are part of the .NET 10 Windows
         Desktop runtime, so they are patched with it and need no package of their own. -->
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="logo.png" />
    <!-- The user guide is built in, so the help assistant can look things up even without the file beside the exe -->
    <EmbeddedResource Include="..\USER-GUIDE.md" LogicalName="USER-GUIDE.md" />
  </ItemGroup>

</Project>


