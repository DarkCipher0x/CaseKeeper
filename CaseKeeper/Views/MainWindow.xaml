<Window x:Class="CaseKeeper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CaseKeeper.UI"
        Style="{StaticResource AppWindow}"
        Foreground="{DynamicResource TextBrush}" Title="CaseKeeper – Family Court Document Manager" Icon="/app.ico"
        Width="1440" Height="900" MinWidth="1100" MinHeight="680" WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <DataTemplate x:Key="PartyCardTemplate">
            <Border Style="{StaticResource Card}" Width="340" Margin="0,0,14,14" Padding="16" Tag="{Binding}" ContextMenuOpening="PartyCard_ContextMenuOpening">
                <Border.ContextMenu><ContextMenu/></Border.ContextMenu>
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding Role}" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Background="{DynamicResource SuccessSoft}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Visibility="{Binding IsMe, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="This is me" Foreground="{DynamicResource Success}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding Representative, Converter={StaticResource EmptyToVis}}">
                        <Run Text="Represented by: " Foreground="{DynamicResource MutedBrush}"/><Run Text="{Binding Representative}"/>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Contact}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               Visibility="{Binding Contact, Converter={StaticResource EmptyToVis}}"/>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Notes}" FontSize="12" MaxHeight="64" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Notes, Converter={StaticResource EmptyToVis}}"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Click="PartyDocuments_Click" Tag="{Binding}" Margin="0,0,6,0">
                            <TextBlock><Run Text="{Binding DocumentCount}"/> document(s) →</TextBlock>
                        </Button>
                        <Button Click="EditParty_Click" Tag="{Binding}" Content="Edit" Margin="0,0,6,0"/>
                        <Button Click="DeleteParty_Click" Tag="{Binding}" Content="Delete" Style="{StaticResource DangerButton}" Margin="0"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <TabControl x:Name="Nav" Style="{StaticResource NavTabControl}" ItemContainerStyle="{StaticResource NavTab}" TextElement.Foreground="{DynamicResource TextBrush}"
                    SelectionChanged="Nav_SelectionChanged">

            <!-- ===================================================== DASHBOARD -->
            <TabItem x:Name="DashboardTab" Header="Dashboard" Tag="&#xE80F;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30,36,30">
                        <TextBlock Style="{StaticResource H1}" x:Name="WelcomeText" Text="Your case at a glance"/>
                        <TextBlock Style="{StaticResource Muted}" Text="Everything for your case, organised and searchable, in one place."/>

                        <WrapPanel Margin="0,22,0,6">
                            <Border Style="{StaticResource Card}" Width="215" Margin="0,0,14,14">
                                <StackPanel>
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Left" FontSize="20"/>
                                    <TextBlock x:Name="StatDocs" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                    <TextBlock Text="Documents" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Width="215" Margin="0,0,14,14">
                                <StackPanel>
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Left" FontSize="20"/>
                                    <TextBlock x:Name="StatPages" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                    <TextBlock Text="Pages, all searchable" x:Name="StatPagesLabel" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Width="215" Margin="0,0,14,14">
                                <StackPanel>
                                    <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Left" FontSize="20"/>
                                    <TextBlock x:Name="StatUpcoming" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                    <TextBlock Text="Upcoming dates" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Width="215" Margin="0,0,14,14">
                                <StackPanel>
                                    <TextBlock Text="&#xE8BD;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Left" FontSize="20"/>
                                    <TextBlock x:Name="StatComplaints" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                    <TextBlock Text="Open complaints" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- Filled in code: case-at-a-glance tiles, what's due soon, and a getting-started checklist -->
                        <StackPanel x:Name="DashboardExtras" Margin="0,0,0,8"/>

                        <WrapPanel Margin="0,0,0,22">
                            <Button Style="{StaticResource PrimaryButton}" Click="Import_Click" Padding="16,9">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Import documents"/></StackPanel>
                            </Button>
                            <Button Click="BulkImport_Click" Padding="16,9" AutomationProperties.Name="Import a whole case folder"
                                    ToolTip="Bulk Case Import: bring in a folder and its subfolders, with optional AI suggestions to review (Ctrl+Shift+I)">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Import a whole folder"/></StackPanel>
                            </Button>
                            <Button Click="GoSearch_Click" Padding="16,9">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Search everything"/></StackPanel>
                            </Button>
                            <Button Click="AddEvent_Click" Padding="16,9">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Add a date or event"/></StackPanel>
                            </Button>
                            <Button Click="GoBundle_Click" Padding="16,9">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Build a bundle or report"/></StackPanel>
                            </Button>
                        </WrapPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Coming up"/>
                                        <TextBlock x:Name="NoUpcomingText" Style="{StaticResource Muted}" Text="No upcoming hearings or deadlines. Add them on the Timeline so you never miss one."/>
                                        <ItemsControl x:Name="UpcomingList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Background="{DynamicResource PrimarySoft}" CornerRadius="6" Padding="8,4" Width="96" Margin="0,0,12,0" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding DaysAwayText}" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" HorizontalAlignment="Center" FontSize="12"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                                                    <Run Text="{Binding DateText, Mode=OneWay}"/> · <Run Text="{Binding EventType}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Complaints awaiting a response"/>
                                        <TextBlock x:Name="NoComplaintsText" Style="{StaticResource Muted}" Text="Nothing outstanding."/>
                                        <ItemsControl x:Name="OpenComplaintsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                                                <Run Text="{Binding Recipient}"/> · <Run Text="{Binding Status}"/> · response due <Run Text="{Binding ResponseDueText, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <TextBlock Text="Response overdue" Foreground="{DynamicResource Danger}" FontWeight="SemiBold" FontSize="12"
                                                                       Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Recently added"/>
                                        <TextBlock x:Name="NoRecentText" Style="{StaticResource Muted}" Text="No documents yet. Click 'Import documents', or drag files onto this window."/>
                                        <ItemsControl x:Name="RecentList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Click="OpenDocFromList_Click" Tag="{Binding}" HorizontalContentAlignment="Stretch" Background="Transparent"
                                                            BorderThickness="0" Padding="4,7" Margin="0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Background="{DynamicResource PrimarySoft}" CornerRadius="4" Padding="5,2" Margin="0,0,10,0" VerticalAlignment="Center" MinWidth="38">
                                                                <TextBlock Text="{Binding FileTypeLabel, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis">
                                                                    <Run Text="{Binding CategoryName}"/> · <Run Text="{Binding DocumentDateText, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Starred documents"/>
                                        <TextBlock x:Name="NoStarredText" Style="{StaticResource Muted}" Text="Star your most important documents to keep them here."/>
                                        <ItemsControl x:Name="StarredList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Click="OpenDocFromList_Click" Tag="{Binding}" HorizontalContentAlignment="Left" Background="Transparent"
                                                            BorderThickness="0" Padding="4,6" Margin="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE735;" Style="{StaticResource Icon}" Foreground="{DynamicResource Star}" Margin="0,0,10,0" FontSize="13"/>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding DocumentDateText, Mode=OneWay, StringFormat='  ·  {0}'}" Foreground="{DynamicResource MutedBrush}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================================================== DOCUMENTS -->
            <TabItem x:Name="DocumentsTab" Header="Documents" Tag="&#xE8A5;">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="310"/>
                    </Grid.ColumnDefinitions>

                    <!-- categories -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="16,18,12,6">
                                <TextBlock Text="Library" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="TreeOptionsButton" Style="{StaticResource IconButton}" Content="&#xE8CB;" ToolTip="Sort and show options"
                                            Click="TreeOptions_Click" Margin="0,0,4,0"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Add your own category"
                                            Click="AddCategory_Click" Margin="0"/>
                                </StackPanel>
                            </Grid>
                            <Grid DockPanel.Dock="Top" Margin="12,0,12,8">
                                <TextBox x:Name="TreeFilterBox" Padding="28,5,8,5" TextChanged="TreeFilterBox_TextChanged"
                                         ToolTip="Find a category by any word or form code (C100, FL401, Form E…)"/>
                                <TextBlock Text="&#xE71C;" Style="{StaticResource Icon}" Foreground="{DynamicResource MutedBrush}" Margin="9,0,0,0" FontSize="12" IsHitTestVisible="False"/>
                                <TextBlock Text="Find a category or form…" Foreground="{DynamicResource MutedBrush}" Margin="29,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=TreeFilterBox, Converter={StaticResource PlaceholderVis}}"/>
                            </Grid>
                            <TreeView x:Name="CategoryTree" BorderThickness="0" Padding="6,0,6,10" SelectedItemChanged="CategoryTree_SelectedItemChanged"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True"
                                      DragOver="CategoryTree_DragOver" Drop="CategoryTree_Drop" ContextMenuOpening="CategoryTree_ContextMenuOpening">
                                <TreeView.ContextMenu><ContextMenu/></TreeView.ContextMenu>
                            </TreeView>
                        </DockPanel>
                    </Border>

                    <!-- list -->
                    <DockPanel Grid.Column="1" Margin="22,20,22,20">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock x:Name="DocListTitle" Style="{StaticResource H1}" FontSize="21" Text="All documents"/>
                            <TextBlock x:Name="DocListSubtitle" Style="{StaticResource Muted}" Text=""/>
                            <Grid Margin="0,14,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource PrimaryButton}" Click="Import_Click" Padding="14,7">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Import"/></StackPanel>
                                </Button>
                                <Button Grid.Column="1" Click="BulkImport_Click" Padding="12,7" Margin="6,0,0,0" AutomationProperties.Name="Import a whole folder"
                                        ToolTip="Bulk Case Import: a folder and all its subfolders (Ctrl+Shift+I)">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Import folder"/></StackPanel>
                                </Button>
                                <Button Grid.Column="2" Click="LibraryCheck_Click" Padding="12,7" Margin="6,0,0,0" AutomationProperties.Name="Check my library"
                                        ToolTip="Library check: organise the documents already here, find copies and versions, and fill in the case sections">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D5;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Check library"/></StackPanel>
                                </Button>
                                <Grid Grid.Column="3" Margin="6,0,0,0">
                                    <TextBox x:Name="DocFilterBox" TextChanged="DocFilterBox_TextChanged" Padding="30,6,8,6"/>
                                    <TextBlock Text="&#xE71C;" Style="{StaticResource Icon}" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" FontSize="12" IsHitTestVisible="False"/>
                                    <TextBlock Text="Filter by title, sender, tag…" Foreground="{DynamicResource MutedBrush}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding Text, ElementName=DocFilterBox, Converter={StaticResource PlaceholderVis}}"/>
                                </Grid>
                            </Grid>
                            <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                                <CheckBox x:Name="LatestOnlyBox" Content="Latest version of each document only" IsChecked="True" VerticalAlignment="Center"
                                          Checked="DocArrange_Changed" Unchecked="DocArrange_Changed" Margin="0,0,18,0"
                                          ToolTip="Drafts and copies of one document show as one line, the latest, with “+ older versions” to see the rest. Nothing is deleted."/>
                                <TextBlock Text="Order:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="ArrangeBox" Width="230" SelectionChanged="DocArrange_Changed" AutomationProperties.Name="Order of the documents">
                                    <ComboBoxItem Tag="importance" Content="Most important first, latest on top"/>
                                    <ComboBoxItem Tag="newest" Content="Newest first"/>
                                    <ComboBoxItem Tag="imported" Content="Most recently added first"/>
                                </ComboBox>
                            </WrapPanel>
                        </StackPanel>
                        <Grid>
                            <DataGrid x:Name="DocGrid" SelectionChanged="DocGrid_SelectionChanged" MouseDoubleClick="DocGrid_MouseDoubleClick"
                                      PreviewKeyDown="DocGrid_KeyDown" ContextMenuOpening="DocGrid_ContextMenuOpening"
                                      PreviewMouseLeftButtonDown="DocGrid_PreviewMouseLeftButtonDown" PreviewMouseMove="DocGrid_PreviewMouseMove"
                                      CanUserReorderColumns="True">
                                <DataGrid.ContextMenu><ContextMenu/></DataGrid.ContextMenu>
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <EventSetter Event="ContextMenuOpening" Handler="DocGridHeader_ContextMenuOpening"/>
                                        <Setter Property="ContextMenu"><Setter.Value><ContextMenu/></Setter.Value></Setter>
                                        <Setter Property="ToolTip" Value="Click to sort · right-click to choose columns"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="30" SortMemberPath="IsImportant" CanUserSort="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="&#xE735;" FontFamily="{DynamicResource IconFont}" Foreground="{DynamicResource Star}" FontSize="12"
                                                           Visibility="{Binding IsImportant, Converter={StaticResource BoolToVis}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Title" SortMemberPath="Title" Width="2.2*" MinWidth="170" CanUserSort="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MutedBrush}" Visibility="{Binding VersionNote, Converter={StaticResource EmptyToVis}}">
                                                        <Hyperlink Click="VersionBadge_Click" Foreground="{DynamicResource AccentText}" ToolTip="Show every version of this document, latest first"
                                                                   AutomationProperties.Name="Show all versions"><Run Text="{Binding VersionNote, Mode=OneWay}"/></Hyperlink>
                                                    </TextBlock>
                                                    <TextBlock x:Name="TitleText" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsOlderVersion}" Value="True">
                                                        <Setter TargetName="TitleText" Property="FontWeight" Value="Normal"/>
                                                        <Setter TargetName="TitleText" Property="Opacity" Value="0.65"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="What it is" Binding="{Binding ImportanceText, Mode=OneWay}" SortMemberPath="ImportanceRank" Width="0.9*" Visibility="Collapsed">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Date" Binding="{Binding DocumentDateText, Mode=OneWay}" SortMemberPath="DocumentDate" Width="100"/>
                                    <DataGridTextColumn Header="Party" Binding="{Binding PartyName}" Width="0.9*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Pages" Binding="{Binding PageCount}" Width="50"/>
                                    <DataGridTextColumn Header="Exhibit" Binding="{Binding ExhibitRef}" Width="70" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="0.8*" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="From" Binding="{Binding Author}" Width="0.8*" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding FileTypeLabel, Mode=OneWay}" Width="55" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText, Mode=OneWay}" SortMemberPath="FileSize" Width="70" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="Added" Binding="{Binding ImportedText, Mode=OneWay}" SortMemberPath="ImportedAt" Width="95" Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="DeletedColumn" Header="Deleted" Binding="{Binding DeletedText, Mode=OneWay}" SortMemberPath="DeletedAt" Width="130" Visibility="Collapsed"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="EmptyDocsPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource FaintIcon}" HorizontalAlignment="Center"/>
                                <TextBlock Text="No documents here yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                <TextBlock Text="Drag and drop files onto this window, or click Import." Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                <TextBlock Text="PDFs, photos/scans, Word (.docx) and text files are all supported." Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>

                    <!-- details -->
                    <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                        <Grid>
                            <TextBlock x:Name="NoSelectionText" Text="Select a document to see its details." Style="{StaticResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
                            <ScrollViewer x:Name="DetailsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel Margin="20,22,20,20">
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding CategoryName}" Foreground="{DynamicResource AccentText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Click="OpenDoc_Click" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" Margin="0,0,7,0" FontSize="13"/><TextBlock Text="Open"/></StackPanel>
                                        </Button>
                                        <Button Click="EditDoc_Click" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" Margin="0,0,7,0" FontSize="13"/><TextBlock Text="Edit"/></StackPanel>
                                        </Button>
                                        <Button Click="ShareDoc_Click" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72D;" Style="{StaticResource Icon}" Margin="0,0,7,0" FontSize="13"/><TextBlock Text="Share"/></StackPanel>
                                        </Button>
                                        <Button Click="ToggleStar_Click" Margin="0,0,6,6" ToolTip="Star / unstar">
                                            <TextBlock Text="&#xE734;" Style="{StaticResource Icon}" Foreground="{DynamicResource Star}" FontSize="13"/>
                                        </Button>
                                    </WrapPanel>

                                    <TextBlock Style="{StaticResource Label}" Text="DOCUMENT DATE"/>
                                    <TextBlock Text="{Binding DocumentDateText, Mode=OneWay}"/>
                                    <TextBlock Style="{StaticResource Label}" Text="FILED BY / PARTY" Visibility="{Binding PartyName, Converter={StaticResource EmptyToVis}}"/>
                                    <TextBlock Text="{Binding PartyName}" TextWrapping="Wrap" Visibility="{Binding PartyName, Converter={StaticResource EmptyToVis}}"/>
                                    <TextBlock Style="{StaticResource Label}" Text="FROM / AUTHOR" Visibility="{Binding Author, Converter={StaticResource EmptyToVis}}"/>
                                    <TextBlock Text="{Binding Author}" TextWrapping="Wrap" Visibility="{Binding Author, Converter={StaticResource EmptyToVis}}"/>
                                    <TextBlock Style="{StaticResource Label}" Text="DATE RECEIVED" Visibility="{Binding DateReceived, Converter={StaticResource NotNullToVis}}"/>
                                    <TextBlock Text="{Binding DateReceived, StringFormat='dd MMM yyyy'}" Visibility="{Binding DateReceived, Converter={StaticResource NotNullToVis}}"/>
                                    <TextBlock Style="{StaticResource Label}" Text="EXHIBIT" Visibility="{Binding ExhibitRef, Converter={StaticResource EmptyToVis}}"/>
                                    <TextBlock Text="{Binding ExhibitRef}" FontWeight="SemiBold" Visibility="{Binding ExhibitRef, Converter={StaticResource EmptyToVis}}"/>
                                    <TextBlock Style="{StaticResource Label}" Text="TAGS" Visibility="{Binding Tags, Converter={StaticResource EmptyToVis}}"/>
                                    <TextBlock Text="{Binding Tags}" TextWrapping="Wrap" Visibility="{Binding Tags, Converter={StaticResource EmptyToVis}}"/>
                                    <TextBlock Style="{StaticResource Label}" Text="SUMMARY" Visibility="{Binding Description, Converter={StaticResource EmptyToVis}}"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Visibility="{Binding Description, Converter={StaticResource EmptyToVis}}"/>
                                    <TextBlock Style="{StaticResource Label}" Text="MY NOTES" Visibility="{Binding Notes, Converter={StaticResource EmptyToVis}}"/>
                                    <Border Background="{DynamicResource WarningSoft}" CornerRadius="6" Padding="10,8" Visibility="{Binding Notes, Converter={StaticResource EmptyToVis}}">
                                        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" MaxHeight="220" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource Label}" Text="ORIGINAL FOLDER" Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVis}}"/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVis}}"
                                               ToolTip="Where this file was in the folder you imported. The file's own date is shown for information only; it is not the document's date.">
                                        <Run Text="{Binding SourcePath, Mode=OneWay}"/><LineBreak/>
                                        File last changed <Run Text="{Binding SourceModifiedAt, StringFormat='dd MMM yyyy', Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Label}" Text="FILE"/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                        <Run Text="{Binding OriginalFileName}"/><LineBreak/>
                                        <Run Text="{Binding PageCount}"/> page(s) · <Run Text="{Binding OcrStatusText, Mode=OneWay}"/><LineBreak/>
                                        Added <Run Text="{Binding ImportedAt, StringFormat='dd MMM yyyy HH:mm'}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" ToolTip="A fingerprint of the file. If it matches, the file is unchanged since you added it.">
                                        SHA-256: <Run Text="{Binding FileHash}" FontFamily="Consolas"/>
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================================================== PARTIES -->
            <TabItem x:Name="PartiesTab" Header="Parties" Tag="&#xE716;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30,36,30">
                        <TextBlock Style="{StaticResource H1}" Text="Parties"/>
                        <TextBlock Style="{StaticResource Muted}" Text="The Applicant(s), Respondent(s) and everyone else involved. Link documents to the party who filed them, then see each party's documents in one click. Parties also fill in the cover page of your bundles."/>
                        <WrapPanel Margin="0,16,0,8">
                            <Button Style="{StaticResource PrimaryButton}" Click="AddParty_Click" Tag="Applicant" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,8,0" FontSize="13"/><TextBlock Text="Add Applicant"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Click="AddParty_Click" Tag="Respondent" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,8,0" FontSize="13"/><TextBlock Text="Add Respondent"/></StackPanel>
                            </Button>
                            <Button Click="AddParty_Click" Tag="Other" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,8,0" FontSize="13"/><TextBlock Text="Add someone else (child, Cafcass, guardian…)"/></StackPanel>
                            </Button>
                        </WrapPanel>

                        <TextBlock Style="{StaticResource H2}" Text="Applicant(s)" Margin="0,14,0,8"/>
                        <TextBlock x:Name="NoApplicantsText" Style="{StaticResource Muted}" Text="No applicant added yet."/>
                        <ItemsControl x:Name="ApplicantsList" ItemTemplate="{DynamicResource PartyCardTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource H2}" Text="Respondent(s)" Margin="0,18,0,8"/>
                        <TextBlock x:Name="NoRespondentsText" Style="{StaticResource Muted}" Text="No respondent added yet."/>
                        <ItemsControl x:Name="RespondentsList" ItemTemplate="{DynamicResource PartyCardTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource H2}" Text="Others involved" Margin="0,18,0,8"/>
                        <TextBlock x:Name="NoOthersText" Style="{StaticResource Muted}" Text="E.g. the child(ren), the Cafcass officer, a Children's Guardian, the local authority."/>
                        <ItemsControl x:Name="OthersList" ItemTemplate="{DynamicResource PartyCardTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================================================== SEARCH -->
            <TabItem x:Name="SearchTab" Header="Search" Tag="&#xE721;">
                <DockPanel Margin="36,30,36,24">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource H1}" Text="Search everything"/>
                        <TextBlock Style="{StaticResource Muted}" Text="Searches titles and details, your notes, and the words inside every scanned page. Put words in &quot;double quotes&quot; to find an exact phrase."/>
                        <Grid Margin="0,18,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" FontSize="16" Padding="12,8" KeyDown="SearchBox_KeyDown"/>
                            <TextBlock Text="e.g. contact centre, &quot;section 7&quot;, Cafcass officer's name…" Foreground="{DynamicResource MutedBrush}" FontSize="16" Margin="14,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource PlaceholderVis}}"/>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="20,8" Click="Search_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Search"/></StackPanel>
                            </Button>
                        </Grid>
                        <WrapPanel>
                            <TextBlock Text="Category" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}"/>
                            <ComboBox x:Name="SearchCategory" Width="260" Margin="0,0,18,0" SelectionChanged="SearchFilter_Changed"/>
                            <TextBlock Text="Dated from" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}"/>
                            <DatePicker x:Name="SearchFrom" Width="130" Margin="0,0,12,0" SelectedDateChanged="SearchFilter_Changed"/>
                            <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}"/>
                            <DatePicker x:Name="SearchTo" Width="130" Margin="0,0,18,0" SelectedDateChanged="SearchFilter_Changed"/>
                            <CheckBox x:Name="SearchNotesOnly" Content="Only search my notes" Checked="SearchFilter_Changed" Unchecked="SearchFilter_Changed"/>
                        </WrapPanel>
                        <TextBlock x:Name="SearchSummary" Style="{StaticResource Muted}" Margin="0,14,0,8"/>
                    </StackPanel>
                    <ListBox x:Name="SearchResults" MouseDoubleClick="SearchResults_MouseDoubleClick" KeyDown="SearchResults_KeyDown"
                             BorderThickness="1" Background="{DynamicResource Surface}" HorizontalContentAlignment="Stretch"
                             ContextMenuOpening="SearchResults_ContextMenuOpening">
                        <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding DocumentTitle}"/>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                            <Run Text="{Binding CategoryName}"/> · <Run Text="{Binding DocumentDateText}"/> · <Run Text="{Binding LocationText, Mode=OneWay}" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock ui:Highlight.Text="{Binding Snippet}" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- ===================================================== TIMELINE -->
            <TabItem x:Name="TimelineTab" Header="Timeline" Tag="&#xE787;">
                <DockPanel Margin="36,30,36,24">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource H1}" Text="Timeline &amp; chronology"/>
                        <TextBlock Style="{StaticResource Muted}" Text="Record hearings, deadlines, incidents, contact and communications as they happen. This becomes the chronology in your bundles and reports, so write each entry factually."/>
                        <WrapPanel Margin="0,16,0,12">
                            <Button Style="{StaticResource PrimaryButton}" Click="AddEvent_Click" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,8,0" FontSize="13"/><TextBlock Text="Add event"/></StackPanel>
                            </Button>
                            <Button Click="EditEvent_Click" Content="Edit" Margin="0,0,6,6"/>
                            <Button Click="DeleteEvent_Click" Content="Delete" Style="{StaticResource DangerButton}" Margin="0,0,18,6"/>
                            <ComboBox x:Name="TimelineTypeFilter" Width="190" Margin="0,0,12,6" SelectionChanged="TimelineFilter_Changed"/>
                            <CheckBox x:Name="TimelineShowDocs" Content="Show documents by date" Margin="0,0,14,6" Checked="TimelineFilter_Changed" Unchecked="TimelineFilter_Changed"/>
                            <CheckBox x:Name="TimelineUpcomingOnly" Content="Upcoming only" Margin="0,0,18,6" Checked="TimelineFilter_Changed" Unchecked="TimelineFilter_Changed"/>
                            <Button Click="ExportChronology_Click" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE749;" Style="{StaticResource Icon}" Margin="0,0,8,0" FontSize="13"/><TextBlock Text="Export chronology (PDF)"/></StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                    <Grid>
                        <ListBox x:Name="TimelineList" MouseDoubleClick="TimelineList_MouseDoubleClick" Background="{DynamicResource Surface}" HorizontalContentAlignment="Stretch"
                                 SelectionMode="Extended" ContextMenuOpening="TimelineList_ContextMenuOpening" KeyDown="TimelineList_KeyDown">
                            <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding EventDate, StringFormat='dd MMM yyyy'}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding EventDate, StringFormat='dddd'}" Style="{StaticResource Muted}" FontSize="12"/>
                                            <TextBlock Text="{Binding Time}" Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding Time, Converter={StaticResource EmptyToVis}}"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1">
                                            <Ellipse Width="11" Height="11" VerticalAlignment="Top" Margin="0,4,0,0" Fill="{DynamicResource Primary}"
                                                     Visibility="{Binding IsDocumentEntry, Converter={StaticResource InverseBoolToVis}}"/>
                                            <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource MutedBrush}" Visibility="{Binding IsDocumentEntry, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <Border Background="{DynamicResource PrimarySoft}" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EventType}" FontSize="11" Foreground="{DynamicResource AccentText}"/>
                                                </Border>
                                                <Border Background="{DynamicResource WarningSoft}" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsUpcoming, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding DaysAwayText, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Warning}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource TextBrush}"
                                                       Visibility="{Binding Description, Converter={StaticResource EmptyToVis}}"/>
                                            <TextBlock Text="{Binding ExtraText, Mode=OneWay}" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                                       Visibility="{Binding ExtraText, Mode=OneWay, Converter={StaticResource EmptyToVis}}"/>
                                            <TextBlock FontSize="12" Margin="0,3,0,0" Visibility="{Binding LinkedDocumentTitle, Converter={StaticResource EmptyToVis}}">
                                                <Hyperlink Click="TimelineDocLink_Click" Tag="{Binding}">
                                                    <Run Text="&#xE8A5;" FontFamily="{DynamicResource IconFont}"/> <Run Text="{Binding LinkedDocumentTitle}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoEventsText" Text="No events yet. Click 'Add event' to start your chronology." Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ===================================================== COMPLAINTS -->
            <TabItem x:Name="ComplaintsTab" Header="Complaints" Tag="&#xE8BD;">
                <DockPanel Margin="36,30,36,24">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource H1}" Text="Complaints &amp; representations"/>
                        <TextBlock Style="{StaticResource Muted}" Text="Keep track of every complaint and letter, to your MP, Cafcass, the Ombudsman, the court service or anyone else: who, when, the reference number, and when a reply is due."/>
                        <WrapPanel Margin="0,16,0,12">
                            <Button Style="{StaticResource PrimaryButton}" Click="AddComplaint_Click" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,8,0" FontSize="13"/><TextBlock Text="New complaint"/></StackPanel>
                            </Button>
                            <Button Click="EditComplaint_Click" Content="Edit" Margin="0,0,6,6"/>
                            <Button Click="DeleteComplaint_Click" Content="Delete" Style="{StaticResource DangerButton}" Margin="0,0,18,6"/>
                            <Button Click="ComplaintPack_Click" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" Margin="0,0,8,0" FontSize="13"/><TextBlock Text="Build a complaint pack from this…"/></StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="ComplaintGrid" SelectionMode="Single" MouseDoubleClick="ComplaintGrid_MouseDoubleClick"
                                  SelectionChanged="ComplaintGrid_SelectionChanged" ContextMenuOpening="ComplaintGrid_ContextMenuOpening">
                            <DataGrid.ContextMenu><ContextMenu/></DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Primary}"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="2*"/>
                                <DataGridTextColumn Header="To" Binding="{Binding Recipient}" Width="1.4*"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding RecipientName}" Width="*"/>
                                <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="110"/>
                                <DataGridTextColumn Header="Sent" Binding="{Binding DateSentText, Mode=OneWay}" SortMemberPath="DateSent" Width="100"/>
                                <DataGridTemplateColumn Header="Reply due" SortMemberPath="ResponseDue" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ResponseDueText, Mode=OneWay}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="NoComplaintsGridText" Text="No complaints recorded." Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" x:Name="ComplaintDetail" Visibility="Collapsed" MaxHeight="300">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Subject}" Style="{StaticResource H2}"/>
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                                        <TextBlock Style="{StaticResource Label}" Text="OUTCOME / RESPONSE" Visibility="{Binding Outcome, Converter={StaticResource EmptyToVis}}"/>
                                        <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" Visibility="{Binding Outcome, Converter={StaticResource EmptyToVis}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="LINKED DOCUMENTS"/>
                                        <ItemsControl x:Name="ComplaintDocsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,2">
                                                        <Hyperlink Click="ComplaintDocLink_Click" Tag="{Binding}"><Run Text="{Binding Title}"/></Hyperlink>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ===================================================== BUNDLES -->
            <TabItem x:Name="BundleTab" Header="Bundles &amp; Reports" Tag="&#xE8F1;">
                <Grid Margin="24,24,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="12,0,0,16">
                        <TextBlock Style="{StaticResource H1}" Text="Bundles &amp; reports"/>
                        <TextBlock Style="{StaticResource Muted}" Text="Compile documents into one paginated PDF court bundle with an index, or a summary report of your documents, notes and chronology, e.g. for your MP or a complaint."/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>

                        <!-- source -->
                        <Border Style="{StaticResource Card}" Padding="14">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Style="{StaticResource H2}" Text="1. Choose documents"/>
                                    <ComboBox x:Name="BundleCategoryFilter" SelectionChanged="BundleSourceFilter_Changed" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,8">
                                        <TextBox x:Name="BundleSourceFilterBox" TextChanged="BundleSourceFilter_Changed"/>
                                        <TextBlock Text="Filter…" Foreground="{DynamicResource MutedBrush}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Visibility="{Binding Text, ElementName=BundleSourceFilterBox, Converter={StaticResource PlaceholderVis}}"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Click="BundleAddTicked_Click" Margin="0,0,0,6" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="Add ticked documents"/><TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" Margin="8,0,0,0" FontSize="12"/></StackPanel>
                                    </Button>
                                    <Button Click="BundleAddAllShown_Click" Content="Add everything shown" HorizontalAlignment="Stretch" Margin="0"/>
                                </StackPanel>
                                <ListBox x:Name="BundleSource" HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                    <TextBlock Style="{StaticResource Muted}" FontSize="11.5">
                                                        <Run Text="{Binding DocumentDateText, Mode=OneWay}"/> · <Run Text="{Binding PageCount}"/>p · <Run Text="{Binding FileTypeLabel, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- arrange -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Style="{StaticResource H2}" Text="2. Arrange"/>
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE74A;" ToolTip="Move up" Click="BundleUp_Click" Margin="0,0,4,4"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE74B;" ToolTip="Move down" Click="BundleDown_Click" Margin="0,0,10,4"/>
                                        <Button Content="Remove" Click="BundleRemove_Click" Margin="0,0,4,4"/>
                                        <Button Content="Sort by section &amp; date" Click="BundleSort_Click" Margin="0,0,4,4"/>
                                        <Button Content="Clear" Click="BundleClear_Click" Style="{StaticResource DangerButton}" Margin="0,0,4,4"/>
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <TextBlock x:Name="BundleSummaryText" Style="{StaticResource Muted}"/>
                                    <Border Style="{StaticResource Callout}" Margin="0,8,0,0">
                                        <TextBlock TextWrapping="Wrap" FontSize="12">
                                            Court bundles normally follow <Bold>Practice Direction 27A</Bold>: sections A–F, an index, pages numbered within each section, and usually <Bold>no more than 350 pages</Bold>. Always follow any directions the court has given about what to include and when to file it.
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <DataGrid x:Name="BundleGrid" IsReadOnly="False" SelectionMode="Extended" CanUserSortColumns="False"
                                          ContextMenuOpening="BundleGrid_ContextMenuOpening">
                                    <DataGrid.ContextMenu><ContextMenu/></DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridComboBoxColumn x:Name="BundleSectionColumn" Header="Section" Width="190"
                                                                SelectedValueBinding="{Binding Section, UpdateSourceTrigger=PropertyChanged}"
                                                                SelectedValuePath="Key" DisplayMemberPath="Value"/>
                                        <DataGridTextColumn Header="Document" Binding="{Binding Title, Mode=OneWay}" Width="*" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Date" Binding="{Binding DateText, Mode=OneWay}" Width="96" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Pages" Binding="{Binding PageCount, Mode=OneWay}" Width="54" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <!-- options -->
                        <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <Button x:Name="GenerateButton" Style="{StaticResource PrimaryButton}" Click="GenerateBundle_Click" Padding="14,10" Margin="0">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE749;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Create PDF…"/></StackPanel>
                                    </Button>
                                    <TextBlock x:Name="BundleStatus" Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12"/>
                                    <WrapPanel x:Name="BundleResultPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                        <Button Content="Open" Click="BundleOpenResult_Click" Margin="0,0,6,0"/>
                                        <Button Content="Share…" Click="BundleShareResult_Click" Margin="0,0,6,0"/>
                                        <Button Content="Show in folder" Click="BundleShowResult_Click" Margin="0"/>
                                    </WrapPanel>
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Style="{StaticResource H2}" Text="3. Options"/>
                                        <RadioButton x:Name="ModeBundle" GroupName="mode" IsChecked="True" Checked="BundleMode_Changed" Margin="0,2">
                                            <TextBlock TextWrapping="Wrap"><Bold>Court bundle</Bold>: full documents, index, page numbers</TextBlock>
                                        </RadioButton>
                                        <RadioButton x:Name="ModeSummary" GroupName="mode" Checked="BundleMode_Changed" Margin="0,4">
                                            <TextBlock TextWrapping="Wrap"><Bold>Summary report</Bold>: chronology, document list, your notes (no full documents)</TextBlock>
                                        </RadioButton>

                                        <TextBlock Style="{StaticResource Label}" Text="TITLE"/>
                                        <TextBox x:Name="BundleTitle" Text="Court Bundle"/>
                                        <TextBlock Style="{StaticResource Label}" Text="CASE NUMBER"/>
                                        <TextBox x:Name="BundleCaseNo"/>
                                        <TextBlock Style="{StaticResource Label}" Text="COURT"/>
                                        <TextBox x:Name="BundleCourt"/>
                                        <TextBlock Style="{StaticResource Label}" Text="PARTIES (one per line)"/>
                                        <TextBox x:Name="BundleParties" Style="{StaticResource MultilineBox}" Height="60"/>
                                        <TextBlock Style="{StaticResource Label}" Text="PREPARED BY"/>
                                        <TextBox x:Name="BundlePreparedBy"/>
                                        <TextBlock Style="{StaticResource Label}" Text="HEARING DATE (optional)"/>
                                        <TextBox x:Name="BundleHearing"/>
                                        <StackPanel x:Name="IntroPanel" Visibility="Collapsed">
                                            <TextBlock Style="{StaticResource Label}" Text="SUMMARY / COVER TEXT"/>
                                            <TextBox x:Name="BundleIntro" Style="{StaticResource MultilineBox}" Height="120"/>
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource Label}" Text="INCLUDE"/>
                                        <CheckBox x:Name="OptCover" Content="Cover page" IsChecked="True"/>
                                        <CheckBox x:Name="OptIndex" Content="Index with page references" IsChecked="True"/>
                                        <CheckBox x:Name="OptChronology" Content="Chronology from your timeline" IsChecked="True"/>
                                        <CheckBox x:Name="OptNotes" Content="My notes (as an annex)"/>
                                        <CheckBox x:Name="OptDividers" Content="Section divider pages"/>
                                        <CheckBox x:Name="OptStamp" Content="Page numbers (A1, B12…)" IsChecked="True"/>
                                        <CheckBox x:Name="OptConfidential" Content="'Confidential – family proceedings' footer" IsChecked="True"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================================================== SETTINGS -->
            <TabItem x:Name="SettingsTab" Header="Settings &amp; Backup" Tag="&#xE713;">
                <ScrollViewer x:Name="SettingsScroller" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SettingsStack" Margin="36,30,36,30" MaxWidth="980" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="Settings &amp; backup"/>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Appearance"/>
                                <TextBlock Style="{StaticResource Muted}" Text="Dark mode is easier on the eyes when you are reading documents late at night. Bundles and reports are always produced on white paper, whichever you choose."/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <RadioButton x:Name="ThemeSystem" GroupName="theme" Content="Match Windows" Margin="0,0,24,0" Checked="Theme_Changed"/>
                                    <RadioButton x:Name="ThemeLight" GroupName="theme" Content="Light" Margin="0,0,24,0" Checked="Theme_Changed"/>
                                    <RadioButton x:Name="ThemeDark" GroupName="theme" Content="Dark" Checked="Theme_Changed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Password protection"/>
                                <TextBlock Style="{StaticResource Muted}" Text="Encrypts the database and every document file on disk with AES-256. CaseKeeper then asks for the password each time it opens, and the files can't be read by anyone browsing the folder."/>
                                <Border Style="{StaticResource Callout}" Margin="0,12,0,0">
                                    <TextBlock TextWrapping="Wrap" FontSize="12">
                                        <Bold>If you forget the password, the data is gone.</Bold> There is no reset and no recovery code — nobody can open the library without it. Keep the password written down somewhere safe, and keep backups.
                                    </TextBlock>
                                </Border>
                                <TextBlock x:Name="ProtectionStatusText" Margin="0,12,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="EnableProtectionButton" Style="{StaticResource PrimaryButton}"
                                            Content="Turn on password protection…" Click="EnableProtection_Click"/>
                                    <Button x:Name="ChangePasswordButton" Content="Change password…" Click="ChangePassword_Click"/>
                                    <Button x:Name="DisableProtectionButton" Content="Turn off…" Style="{StaticResource DangerButton}"
                                            Click="DisableProtection_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Your library"/>
                                <TextBlock Style="{StaticResource Muted}" Text="Imported files are copied into this folder. Your original files are not changed or moved. You can keep the library anywhere — an external disk or a network drive, for example."/>
                                <TextBlock x:Name="LibraryPathText" Margin="0,10,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                                <TextBlock x:Name="LibraryLocationNote" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Open library folder" Click="OpenLibraryFolder_Click"/>
                                    <Button x:Name="MoveLibraryButton" Content="Move library…" Click="MoveLibrary_Click"
                                            ToolTip="Copy everything to a new folder and remove it from here"/>
                                    <Button x:Name="ChangeLibraryButton" Content="Use a different library…" Click="ChangeLibrary_Click"
                                            ToolTip="Open a library in another folder (e.g. on a NAS shared by several PCs) without moving any data"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" FontSize="12"
                                           Text="Tip: turn on BitLocker / Device encryption in Windows Settings and use a password on your Windows account to keep these files private if your PC is lost or shared."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Backup &amp; transfer"/>
                                <TextBlock Style="{StaticResource Muted}" Text="A backup is one .zip holding everything: every document file and the whole database – notes, timeline, parties, complaints, hearings, orders, directions, contact log, costs, Scott schedule, letters, templates, letterheads, AI reports, all your settings and AI prompts, and the audit trail. Keep a copy somewhere safe, e.g. a USB stick."/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Importing offers two choices: add the backup to what's already here (safe to repeat — duplicates are skipped), or replace everything for disaster recovery or moving to another PC. Upgrading CaseKeeper itself never needs this; your library is kept outside the app folder and is picked up automatically by a new version."/>
                                <CheckBox x:Name="BackupEncrypt" Content="Protect the backup with a password (AES-256 encryption)" Margin="0,12,0,0"
                                          Checked="BackupEncrypt_Changed" Unchecked="BackupEncrypt_Changed"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="26,0,0,0" TextWrapping="Wrap"
                                           Text="You will be asked for a password each time you back up. Keep it somewhere safe: without it the backup cannot be opened, by you or anyone else. Encrypted backups open in 7-Zip or WinRAR, but not in File Explorer's built-in zip viewer."/>
                                <TextBlock x:Name="LastBackupText" Margin="0,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Create backup…" Click="Backup_Click"/>
                                    <Button Content="Import from backup…" Click="ImportBackup_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Text recognition (OCR)"/>
                                <TextBlock Style="{StaticResource Muted}" Text="Every imported PDF and image is scanned with the OCR engine built into Windows, so you can search the words inside scanned letters and photos. Everything is processed on this PC; nothing is uploaded."/>
                                <TextBlock x:Name="OcrEngineText" Margin="0,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Scan any documents that failed" Click="RescanFailed_Click"/>
                                    <Button Content="Re-scan all documents" Click="RescanAll_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Categories"/>
                                <TextBlock Style="{StaticResource Muted}" Text="The built-in list covers common family court forms (C1, C2, C100, C79, FL401…), orders, Cafcass and local authority documents. Add your own or change which bundle section each category goes into by default."/>
                                <ListBox x:Name="CategoryList" Height="260" Margin="0,12,0,8" HorizontalContentAlignment="Stretch" MouseDoubleClick="EditCategory_Click">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding GroupName}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding BundleSection, StringFormat='Section {0}'}" Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding DocumentCount, StringFormat='{}{0} docs'}" Foreground="{DynamicResource MutedBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel>
                                    <Button Content="Add category…" Click="AddCategory_Click"/>
                                    <Button Content="Edit…" Click="EditCategory_Click"/>
                                    <Button Content="Delete…" Style="{StaticResource DangerButton}" Click="DeleteCategory_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Sharing &amp; confidentiality"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
                                    In England &amp; Wales, documents and information from family proceedings about children are usually private. Sharing them with people who aren't a party
                                    can be contempt of court unless it is allowed by the Family Procedure Rules (rule 12.73 and Practice Direction 12G) or the court gives permission.
                                    PD 12G allows some disclosure, for example to a lay adviser or McKenzie friend, a professional regulator, or an MP/peer (to whom it generally allows
                                    the text or a summary of a <Italic>judgment</Italic>, rather than all the papers). Check the current rules, or ask the court or a legal adviser,
                                    before sending case papers to anyone.
                                </TextBlock>
                                <CheckBox x:Name="ConfidentialityReminder" Content="Remind me about this each time I share or export" Margin="0,12,0,0"
                                          Checked="ConfidentialityReminder_Changed" Unchecked="ConfidentialityReminder_Changed"/>
                            </StackPanel>
                        </Border>


                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="About"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="/logo.png" Width="64" Height="64" VerticalAlignment="Top" Margin="0,2,18,0"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="CaseKeeper" FontSize="22" FontWeight="Bold"/>
                                        <TextBlock x:Name="AboutVersionText" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                        <TextBlock Text="Family court case manager for England &amp; Wales" Style="{StaticResource Muted}"/>

                                        <TextBlock Style="{StaticResource Label}" Text="DEVELOPED BY"/>
                                        <TextBlock Text="DarkCipher Systems" FontWeight="SemiBold" FontSize="15"
                                                   Foreground="{DynamicResource AccentText}"/>

                                        <TextBlock Style="{StaticResource Label}" Text="LICENCE"/>
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Text="MIT — free to use, copy and share. Provided as-is, with no warranty."/>

                                        <TextBlock Style="{StaticResource Label}" Text="PLEASE NOTE"/>
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Text="CaseKeeper helps you organise and present your documents. It does not give legal advice, and nothing it produces replaces advice from a solicitor, barrister or advice service. Bundles follow the general shape of Practice Direction 27A, but always check what your court has directed."/>

                                        <WrapPanel Margin="0,16,0,0">
                                            <Button Content="What's new…" Click="ShowChangelog_Click"/>
                                            <Button Content="User guide…" Click="ShowUserGuide_Click"/>
                                            <Button Content="Open library folder" Click="OpenLibraryFolder_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource Danger}" BorderThickness="1"
                                CornerRadius="10" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Factory reset" Foreground="{DynamicResource Danger}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="Wipes CaseKeeper back to how it was the first time you opened it: every document, note, timeline entry, complaint, party and setting is deleted, and the categories go back to the built-in list. The original files you imported from are not touched."/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" FontWeight="SemiBold"
                                           Text="You will be asked to confirm, and offered a backup first. There is no undo."/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Factory reset…" Style="{StaticResource DangerButton}" Click="FactoryReset_Click"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Remove all CaseKeeper data from this PC" Margin="0,18,0,0" Foreground="{DynamicResource Danger}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="Uninstalling CaseKeeper deliberately leaves your case libraries in place, so reinstalling picks up where you left off. Use this before uninstalling if you want them gone too: it deletes every case library on this PC that CaseKeeper knows about, its settings, logs and temporary copies, then closes CaseKeeper. Libraries on network drives are left alone."/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Remove all CaseKeeper data…" Style="{StaticResource DangerButton}" Click="RemoveAllData_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- background task indicator -->
        <Border x:Name="TaskBanner" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,14" Visibility="Collapsed"
                Background="{DynamicResource Sidebar}" CornerRadius="8" Padding="14,9">
            <StackPanel Orientation="Horizontal">
                <ProgressBar IsIndeterminate="True" Width="60" Height="5" Margin="0,0,10,0" Foreground="{DynamicResource PrimaryHover}" Background="{DynamicResource SidebarHover}" BorderThickness="0"/>
                <TextBlock x:Name="TaskBannerText" Foreground="White" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>