<Window x:Class="CaseKeeper.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Foreground="{DynamicResource TextBrush}" Title="Add documents" Width="1220" Height="660" MinWidth="900" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" x:Name="Root">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" FontSize="20" x:Name="HeaderText" Text="Add documents"/>
            <TextBlock Style="{StaticResource Muted}" Text="Check the details for each file. Category and date have been guessed from the file name where possible, and you can change anything later. Use the ✕ at the end of a row to drop a file you didn't mean to pick."/>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,14,0,12">
                <WrapPanel>
                    <TextBlock Text="Set for all files:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox x:Name="AllCategory" Width="320" DisplayMemberPath="DisplayName" Margin="0,0,6,0"
                              ToolTip="Type any word or a form code (e.g. C100, Form E) to find a category"/>
                    <Button Content="Apply category" Click="ApplyCategory_Click" Margin="0,0,18,0"/>
                    <ComboBox x:Name="AllParty" Width="220" ItemsSource="{Binding Parties, ElementName=Root}" DisplayMemberPath="DisplayName" Margin="0,0,6,0"/>
                    <Button Content="Apply party" Click="ApplyParty_Click" Margin="0,0,18,0"/>
                    <DatePicker x:Name="AllDate" Width="130" Margin="0,0,6,0"/>
                    <Button Content="Apply date" Click="ApplyDate_Click" Margin="0,0,18,0"/>
                    <Button Content="Remove selected" Click="RemoveSelected_Click" Style="{StaticResource DangerButton}" Margin="0"/>
                </WrapPanel>
            </Border>
        </StackPanel>
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Padding="18,7"/>
                <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Content="Add to library" IsDefault="True"
                        Click="Ok_Click" Padding="18,7" Margin="0"/>
            </StackPanel>
        </Grid>
        <Grid>
            <DataGrid x:Name="Grid" IsReadOnly="False" SelectionMode="Extended" RowHeight="40" CanUserSortColumns="False"
                      KeyDown="Grid_KeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File" Binding="{Binding FileName, Mode=OneWay}" Width="170" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                <Setter Property="ToolTip" Value="{Binding SourcePath}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Title" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="5,3"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Category" Width="1.6*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Categories, ElementName=Root}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                          SelectedValue="{Binding CategoryId, UpdateSourceTrigger=PropertyChanged}" MinHeight="26" Padding="5,3"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Filed by / party" Width="1.1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Parties, ElementName=Root}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                          SelectedValue="{Binding PartyId, UpdateSourceTrigger=PropertyChanged}" MinHeight="26" Padding="5,3"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Document date" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><DatePicker SelectedDate="{Binding DocumentDate, UpdateSourceTrigger=PropertyChanged}" MinHeight="26"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="From / author" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" Padding="5,3"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="42">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="RemoveRow_Click" Tag="{Binding}" Style="{StaticResource IconButton}" Content="&#xE711;"
                                        ToolTip="Remove this file from the list" Padding="7,4" Margin="0"
                                        Foreground="{DynamicResource Danger}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="34" Foreground="{DynamicResource FaintIcon}" HorizontalAlignment="Center"/>
                <TextBlock Text="You've removed every file from this list." Margin="0,12,0,0" Style="{StaticResource Muted}"/>
                <TextBlock Text="Press Cancel and start again." Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
