<Window x:Class="CaseKeeper.Views.DocumentViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Foreground="{DynamicResource TextBrush}" Title="Document" Width="1380" Height="900" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Icon="/app.ico">
    <DockPanel>
        <!-- toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" MaxWidth="460" Margin="0,0,20,0">
                    <TextBlock x:Name="DocTitle" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="DocMeta" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" ToolTip="Previous page (Page Up)" Click="Prev_Click" Margin="0,0,4,0"/>
                    <TextBox x:Name="PageBox" Width="44" HorizontalContentAlignment="Center" KeyDown="PageBox_KeyDown" Padding="4,5"/>
                    <TextBlock x:Name="PageCountText" VerticalAlignment="Center" Margin="6,0,6,0" Foreground="{DynamicResource MutedBrush}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="Next page (Page Down)" Click="Next_Click" Margin="0,0,16,0"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE71F;" ToolTip="Zoom out (Ctrl + mouse wheel)" Click="ZoomOut_Click" Margin="0,0,4,0"/>
                    <TextBlock x:Name="ZoomText" VerticalAlignment="Center" Width="44" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" ToolTip="Zoom in" Click="ZoomIn_Click" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE9A6;" ToolTip="Fit to width" Click="FitWidth_Click" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE7AD;" ToolTip="Rotate view" Click="Rotate_Click" Margin="0,0,16,0"/>
                    <Button Click="Star_Click" x:Name="StarButton" ToolTip="Star / unstar" Margin="0,0,4,0" Padding="9,6">
                        <TextBlock x:Name="StarIcon" Text="&#xE734;" Style="{StaticResource Icon}" Foreground="{DynamicResource Star}" FontSize="14"/>
                    </Button>
                    <Button Click="Edit_Click" Content="Edit details" Margin="0,0,4,0"/>
                    <Button Click="AddEvent_Click" Content="Add to timeline" Margin="0,0,4,0"/>
                    <Button Click="Share_Click" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72D;" Style="{StaticResource Icon}" Margin="0,0,6,0" FontSize="13"/><TextBlock Text="Share"/></StackPanel>
                    </Button>
                    <Button Click="OpenExternal_Click" Content="Open in default app" Margin="0"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- page list -->
        <Border DockPanel.Dock="Left" Width="130" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <ListBox x:Name="PageList" BorderThickness="0" SelectionChanged="PageList_SelectionChanged" Padding="4,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,5">
                            <TextBlock Text="{Binding Label}" Width="64"/>
                            <TextBlock Text="&#xE70B;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Warning}" ToolTip="Has a note"
                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- notes panel -->
        <Border DockPanel.Dock="Right" Width="380" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid Margin="16,14,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="80"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock x:Name="SavedText" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Success}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PageNoteLabel" Text="Notes for page 1" FontWeight="SemiBold" FontSize="14"/>
                </DockPanel>
                <TextBox x:Name="PageNoteBox" Grid.Row="1" Style="{StaticResource MultilineBox}" Margin="0,8,0,0" TextChanged="PageNoteBox_TextChanged"
                         ToolTip="Type context for this page: what's wrong, what's missing, what it relates to. Saved automatically."/>
                <TextBlock Grid.Row="2" Text="Notes for the whole document" FontWeight="SemiBold" FontSize="14" Margin="0,14,0,0"/>
                <TextBox x:Name="DocNoteBox" Grid.Row="3" Style="{StaticResource MultilineBox}" Margin="0,8,0,0" TextChanged="DocNoteBox_TextChanged"/>
                <StackPanel Grid.Row="4" Margin="0,14,0,0">
                    <TextBlock Text="Find in this document" FontWeight="SemiBold" FontSize="14"/>
                    <Grid Margin="0,8,0,0">
                        <TextBox x:Name="FindBox" KeyDown="FindBox_KeyDown"/>
                        <TextBlock Text="Type a word and press Enter" Foreground="{DynamicResource MutedBrush}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=FindBox, Converter={StaticResource PlaceholderVis}}"/>
                    </Grid>
                    <ListBox x:Name="FindResults" MaxHeight="130" Margin="0,6,0,0" SelectionChanged="FindResults_SelectionChanged" Visibility="Collapsed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" FontSize="12"><Bold><Run Text="{Binding Item1, Mode=OneWay, StringFormat='Page {0}: '}"/></Bold><Run Text="{Binding Item2, Mode=OneWay}"/></TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Expander Header="Text found on this page (copyable)" Margin="0,12,0,0" x:Name="TextExpander" Expanded="TextExpander_Expanded">
                        <TextBox x:Name="PageTextBox" IsReadOnly="True" Style="{StaticResource MultilineBox}" Height="170" Margin="0,6,0,0" FontSize="12"/>
                    </Expander>
                </StackPanel>
            </Grid>
        </Border>

        <!-- page view -->
        <Grid Background="{DynamicResource ViewerBackground}">
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="Scroller_PreviewMouseWheel">
                <Border x:Name="PageFrame" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Top" Background="White">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="{DynamicResource ShadowOpacity}"/>
                    </Border.Effect>
                    <Image x:Name="PageImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.LayoutTransform>
                            <RotateTransform x:Name="PageRotation" Angle="0"/>
                        </Image.LayoutTransform>
                    </Image>
                </Border>
            </ScrollViewer>
            <TextBox x:Name="TextContent" Visibility="Collapsed" IsReadOnly="True" Style="{StaticResource MultilineBox}" Margin="24"
                     FontSize="14" Padding="24,20" FontFamily="Segoe UI"/>
            <StackPanel x:Name="UnsupportedPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="44" Foreground="{DynamicResource FaintIcon}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="UnsupportedText" FontSize="15" Margin="0,14,0,10" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                <Button Content="Open in default app" Click="OpenExternal_Click" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
            <TextBlock x:Name="LoadingText" Text="Loading…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
